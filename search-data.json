---
---
{
  "index": [
    {% assign items = "" | split: "" %}
    
    {% for post in site.posts %}
      {% capture json_item %}
      {
        "id": {{ forloop.index | jsonify }},
        "title": {{ post.title | jsonify }},
        "url": {{ post.url | relative_url | jsonify }},
        "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
        "content": {{ post.content | strip_html | strip_newlines | jsonify }}
      }
      {% endcapture %}
      {% assign items = items | push: json_item %}
    {% endfor %}

    {% assign page_index_offset = site.posts.size %}
    {% for page in site.pages %}
      {% if page.title and page.url and page.url != "/course/" and page.url != "/search/" and page.search_exclude != true and page.layout != "tags" and page.layout != "categories" %}
        {% capture json_item %}
        {
          "id": {{ forloop.index | plus: page_index_offset | jsonify }},
          "title": {{ page.title | jsonify }},
          "url": {{ page.url | relative_url | jsonify }},
          "date": {{ page.date | date: "%Y-%m-%d" | jsonify }},
          "content": {{ page.content | strip_html | strip_newlines | jsonify }}
        }
        {% endcapture %}
        {% assign items = items | push: json_item %}
      {% endif %}
    {% endfor %}

    {{ items | join: "," }}
  ]
}
